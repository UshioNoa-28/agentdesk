{
  "mcpServers": {
    "exa-search": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      },
      "timeout_seconds": 120,
      "enabled": true,
      "description": "Searches the public web using Exa for current information, documentation, recent facts, source discovery, and relevant webpage content. Route requests here when an answer depends on external web research rather than the local AgentDesk knowledge base. It does not inspect local files, execute code, or modify the workspace."
    }
  }
}
