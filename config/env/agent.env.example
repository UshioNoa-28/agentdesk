# Real deltas only; every default lives in agent/infrastructure/settings.py.
SERVICE_REQUEST_TIMEOUT_SECONDS=120
# Optional; leave blank until the Exa MCP server is enabled for this deployment.
EXA_API_KEY=
# Workspace the file tools and the .agent-desk discovery
# chain (skills/mcp/settings) start from; empty = process cwd.
# Point it at the user project to make /review and edit_file real.
WORKSPACE_ROOT=
# Directory holding per-session driver locks (flock) for multi-instance safety.
# SESSION_LOCK_DIR=data/locks
