# Mem0 长期记忆开关与 Qdrant 向量数据库配置
MEMORY_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agent_memories
# search_memory 单次最多返回的记忆条数
MEMORY_SEARCH_MAX_LIMIT=40

# 记忆提炼与消歧 LLM 模型 (支持 openai, ollama 等)
MEMORY_LLM_PROVIDER=openai
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=

# 记忆向量化 Embedder 模型 (支持 openai, ollama, 本地等)
MEMORY_EMBEDDER_PROVIDER=openai
MEMORY_EMBEDDER_MODEL=text-embedding-3-small
MEMORY_EMBEDDER_API_KEY=
MEMORY_EMBEDDER_BASE_URL=
# 向量维度：MEMORY_ENABLED=true 时必须配置，且必须与 embedder 实际输出一致
# (mxbai-embed-large 为 1024, text-embedding-3-small 为 1536)
MEMORY_EMBEDDER_DIMS=1024

# 记忆审计与诊断日志文件路径
MEMORY_LOG_PATH=logs/memory.log

