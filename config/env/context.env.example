CONTEXT_COLD_COMPACT_TARGET_RATIO=0.50
CONTEXT_MAX_RECENT_TOOL_CALLS=4
CONTEXT_MAX_TOOL_RESULT_TOKENS=8000
CONTEXT_CLEAR_TOOL_RESULT_THRESHOLD_TOKENS=100
CONTEXT_SUMMARY_MAX_TOKENS=4000
