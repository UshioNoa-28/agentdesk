# OpenAI-compatible provider used by Model Service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Maximum output tokens for each model response, including summaries.
# Leave empty to use CONTEXT_RESERVE_RATIO as the fallback.
OPENAI_MAX_OUTPUT_TOKENS=4096
# Only enable when the provider explicitly supports /v1/responses.
OPENAI_USE_RESPONSES_API=false
# Streaming "content silence" ceiling in seconds: max gap between parsed
# chunks. Catches a provider that never starts or stalls mid-generation;
# does not cap the total time of a slow-but-valid output. Streaming only.
# Leave empty to keep LangChain's default (120s).
OPENAI_STREAM_CHUNK_TIMEOUT_SECONDS=
# HTTP-layer timeout in seconds, forwarded to httpx (all four phases get the
# same value). For streaming this acts as an inter-byte cap (never fires while
# bytes drip); for non-streaming calls (subagents, summaries) it degrades to a
# total-duration hard cut. Leave empty to keep the SDK/httpx default.
OPENAI_REQUEST_TIMEOUT_SECONDS=
